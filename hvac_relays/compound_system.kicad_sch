	(text "System mode (skipped relays are irrelevant):\n\n  Off\n    - K7 on (NO)\n    - K8 on (NO)\n\n  Cooling\n    - K1 on (NO)\n    - K2 on (NO)\n    - K3 fan control\n    - K4 on (NO)\n    - K5 zone 1 call\n    - K6 zone 2 call\n    - K7 off (NC)\n    - K8 off (NC)\n\n  Heating\n    - K1 off (NC)\n    - K2 off (NC)\n    - K3 fan control (see below)\n    - K4 off (NC)\n    - K5 zone 1 call\n    - K6 zone 2 call\n    - K7 off (NC)\n    - K8 off (NC)\n\n  Fan only mode\n    - K2 on (NO)\n    - K3 fan control (see below)\n    - K4 off (NC)\n    - K5 off (NC)\n    - K6 off (NC)\n    - K7 on (NO)\n    - K8 off (NC)\n\nFan control:\n\n  Cooling\n    - auto = K3 off (NC)\n    - on = K3 on (NO)\n  \n  Heating\n    - off = K3 off (NC) [auto]\n    - on = K3 on (NO)\n\n  Fan only\n    - off = K3 off (NC)\n    - on = K3 on (NO)\n"
		(exclude_from_sim no)
		(at 214.63 19.304 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.1588)
			)
			(justify left top)
		)
		(uuid "ea65bfc1-d053-4c94-bb9a-98eb7c4d406c")
	)

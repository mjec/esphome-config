	(text "Wall mode control"
		(exclude_from_sim no)
		(at 102.362 98.806 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.254)
				(bold yes)
			)
			(justify left)
		)
		(uuid "d549e654-467a-46ee-8d5b-e6d242365454")
	)
	(text "System mode:\n\n  Off\n    - HVAC-12 not connected\n    - HVAC-18 not connected\n\n  Cooling\n    - HVAC-12 connected to HVAC-14\n    - HVAC-18 connected to HVAC-19\n    - HVAC-15 connected to HVAC-14 if fan auto\n\n  Heating\n    - HVAC-12 connected to HVAC-11\n    - HVAC-18 connected to HVAC-17\n    - HVAC-15 not connected if fan auto\n\n  Fan only mode\n    - HVAC-12 not connected\n    - HVAC-18 connected to HVAC-19"
		(exclude_from_sim no)
		(at 159.766 19.304 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.1588)
			)
			(justify left top)
		)
		(uuid "dfa750d9-003f-4a3b-9977-5ed24f36b786")
	)
	(text "SW1-A and SW1-B must\nbe physically interlocked\nto avoid malfunction and\npotential damage."
		(exclude_from_sim no)
		(at 20.32 132.08 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.254)
				(bold yes)
				(color 194 0 0 1)
			)
			(justify left top)
		)
		(uuid "e0f605d5-50f2-43b5-a658-1fddfc1a033d")
	)
	(text "Calling for heat/cooling:\n  \n  Zone 1\n    - T5-Z1 connected to T6-Z1 if cooling\n    - T5-Z1 connected to T4-Z1 if heating\n    - T6-Z1 is always connected to HVAC-19\n    - T4-Z1 is always connected to HVAC-17\n\n  Zone 2\n    - T5-Z2 connected to T6-Z2 if cooling\n    - T5-Z2 connected to T4-Z2 if heating\n    - T6-Z2 is always connected to HVAC-19\n    - T4-Z2 is always connected to HVAC-17\n"
		(exclude_from_sim no)
		(at 62.992 19.304 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.1588)
			)
			(justify left top)
		)
		(uuid "e473aad5-d24a-4df8-bb5d-83c33ca55a11")
	)
	(text "System mode (skipped relays are irrelevant):\n\n  Off\n    - K7 on (NO)\n    - K8 on (NO)\n\n  Cooling\n    - K1 on (NO)\n    - K2 on (NO)\n    - K3 fan control\n    - K4 on (NO)\n    - K5 zone 1 call\n    - K6 zone 2 call\n    - K7 off (NC)\n    - K8 off (NC)\n\n  Heating\n    - K1 off (NC)\n    - K2 off (NC)\n    - K3 fan control (see below)\n    - K4 off (NC)\n    - K5 zone 1 call\n    - K6 zone 2 call\n    - K7 off (NC)\n    - K8 off (NC)\n\n  Fan only mode\n    - K2 on (NO)\n    - K3 fan control (see below)\n    - K4 off (NC)\n    - K5 off (NC)\n    - K6 off (NC)\n    - K7 on (NO)\n    - K8 off (NC)\n\nFan control:\n\n  Cooling\n    - auto = K3 off (NC)\n    - on = K3 on (NO)\n  \n  Heating\n    - off = K3 off (NC) [auto]\n    - on = K3 on (NO)\n\n  Fan only\n    - off = K3 off (NC)\n    - on = K3 on (NO)\n"
		(exclude_from_sim no)
		(at 214.63 19.304 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.1588)
			)
			(justify left top)
		)
		(uuid "ea65bfc1-d053-4c94-bb9a-98eb7c4d406c")
	)
	(text "We can leave W & Y\nconnected to T4 & T6\nbecause if SW1 is set\nto smart, R is not\nconnected."
